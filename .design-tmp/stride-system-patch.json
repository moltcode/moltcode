    {"op":"setPath","path":"model.theme.shaders.pulseGlow","value":{
      "source":"uniform float2 size; uniform float4 deep; uniform float4 glow; half4 main(float2 xy) { float2 uv = size.x > 0.0 ? xy / size : float2(0.5); float d = distance(uv, float2(0.28, 0.18)); float g = smoothstep(0.95, 0.0, d); float vig = smoothstep(1.35, 0.2, distance(uv, float2(0.5))); float4 c = mix(deep, glow, g * 0.55); return half4(c.rgb * (0.82 + 0.18 * vig), 1.0); }",
      "uniforms":{
        "deep":{"type":"color","default":"#0B3B2C"},
        "glow":{"type":"color","default":"#2E9B68"}
      },
      "fallback":"heroLinear"
    }},
    {"op":"setPath","path":"model.theme.paints.heroGlow","value":{"type":"shader","shader":"pulseGlow","fallback":"heroLinear"}},

