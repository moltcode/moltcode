---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import DownloadHero from '../components/DownloadHero.astro';
import WorkspaceContinuity from '../components/WorkspaceContinuity.astro';
import ThreadFlow from '../components/ThreadFlow.astro';
import AgentRoster from '../components/AgentRoster.astro';
import ChatSample from '../components/ChatSample.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Molt Code — a collaborative workspace for your team"
  description="Work, report bugs, and fix them all in one place. Connect Linear and your stack, and new teammates get immediate access to everything — without a hundred subscriptions."
>
  <Nav />
  <DownloadHero />
  <ChatSample />
  <WorkspaceContinuity />
  <ThreadFlow />
  <AgentRoster />
  <Footer />
</Layout>
