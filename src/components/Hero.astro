---
import { config } from '../config';
import AppleIcon from './AppleIcon.astro';
---

<section class="hero" id="hero">
  <div class="hero-inner">
    <!-- Status chips -->
    <div class="hero-chips">
      <span class="chip chip-accent">v{config.version}</span>
      <span class="chip">Free forever</span>
      <span class="chip">Every device</span>
    </div>

    <!-- Headline -->
    <h1 class="hero-headline">
      <span class="hero-typed" data-typed-headline>Leave your laptop at home</span><span class="caret"></span>
    </h1>

    <!-- Description -->
    <p class="hero-desc">
      The dev workspace for shipping with agents — same app on desktop, iPad, and phone. Spec a PRD, get a dependency-ordered tree of issues, agents resolve it. You review the diffs from anywhere.
    </p>

    <!-- CTAs -->
    <div class="hero-ctas" data-download-cta>
      <a href={config.downloadUrl} data-track-download data-download-platform="macos" data-download-architecture="arm64" data-cta-placement="homepage_hero_primary" data-dl="mac-arm" class="btn btn-primary">
        <AppleIcon size={16} />
        download.mac
      </a>
      <a href={config.appStoreUrl} data-track-download data-download-platform="ios" data-download-architecture="universal" data-cta-placement="homepage_hero_primary" data-dl="ios" class="btn btn-primary">
        <AppleIcon size={16} />
        download.ios
      </a>
      <div class="hero-dl-more">
        <button type="button" class="btn" data-dl-toggle>
          all.platforms
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="hero-dl-dropdown" data-dl-dropdown>
          <a href={config.downloadUrl} data-track-download data-download-platform="macos" data-download-architecture="arm64" data-cta-placement="homepage_hero_platform_menu" class="hero-dl-item">
            <AppleIcon size={14} />
            macos.apple-silicon
          </a>
          <a href={config.appStoreUrl} data-track-download data-download-platform="ios" data-download-architecture="universal" data-cta-placement="homepage_hero_platform_menu" class="hero-dl-item">
            <AppleIcon size={14} />
            ios.app-store
          </a>
        </div>
      </div>
    </div>

    <!-- Output line -->
    <div class="hero-output">
      <span class="hero-output-key">→</span> not a remote viewer. not a phone companion. the same workspace, every device.
    </div>
  </div>
</section>

<script>
  const headline = document.querySelector<HTMLElement>('[data-typed-headline]');

  if (headline && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const phrases = [
      'Leave your laptop at home',
      'Access from anywhere',
      'Highly scalable workspace for teams',
      'and individuals',
    ];
    const typeDelay = 54;
    const deleteDelay = 28;
    const holdDelay = 1400;
    let phraseIndex = 0;

    const sleep = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

    const typePhrase = async (phrase: string) => {
      for (let i = 1; i <= phrase.length; i += 1) {
        headline.textContent = phrase.slice(0, i);
        await sleep(typeDelay);
      }
    };

    const deletePhrase = async () => {
      const phrase = headline.textContent ?? '';
      for (let i = phrase.length; i >= 0; i -= 1) {
        headline.textContent = phrase.slice(0, i);
        await sleep(deleteDelay);
      }
    };

    const runTypingLoop = async () => {
      headline.textContent = phrases[0];

      while (true) {
        await sleep(holdDelay);
        await deletePhrase();
        phraseIndex = (phraseIndex + 1) % phrases.length;
        await typePhrase(phrases[phraseIndex]);
      }
    };

    runTypingLoop();
  }
</script>

<style>
  .hero {
    padding: 6rem 1.25rem 3rem;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .hero {
      padding: 8rem 2rem 4rem;
    }
  }

  .hero-inner {
    width: 100%;
    max-width: 38rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-headline {
    font-family: var(--font-family-sans);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 0;
    max-width: 17ch;
    min-height: 2.3em;
  }

  .hero-typed {
    display: inline;
  }

  .hero-desc {
    font-family: var(--font-family-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-secondary);
    max-width: 32rem;
    margin: 0;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    position: relative;
    margin-top: 0.5rem;
  }

  /* Platform-based primary button visibility */
  [data-dl] {
    display: none;
  }

  :global([data-platform="mac-arm"]) [data-dl="mac-arm"],
  :global([data-platform="ios"]) [data-dl="ios"] {
    display: inline-flex;
  }

  .hero-dl-more {
    position: relative;
  }

  .hero-dl-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 0;
    flex-direction: column;
    min-width: 14rem;
    padding: 0.25rem;
    border-radius: 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    z-index: 50;
  }

  .hero-dl-dropdown:global(.open) {
    display: flex;
  }

  .hero-dl-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 6px;
    font-family: var(--font-family-mono);
    font-size: 12px;
    color: var(--color-primary);
    transition: background 120ms ease, color 120ms ease;
  }

  .hero-dl-item:hover {
    background: var(--color-bg);
    color: var(--color-accent);
  }

  .hero-output {
    font-family: var(--font-family-mono);
    font-size: 12px;
    color: var(--color-muted);
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
    width: 100%;
    margin-top: 0.5rem;
  }

  .hero-output-key {
    color: var(--color-accent);
    margin-right: 0.375rem;
  }
</style>
