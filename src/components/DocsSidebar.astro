---

<aside class="docs-sidebar">
  <div class="sidebar-inner">
    <a href="/" class="sidebar-logo">
      <svg width="24" height="24" viewBox="0 0 64 64" class="rounded-md">
        <defs>
          <linearGradient id="sbBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#27272a"/>
            <stop offset="100%" stop-color="#3f3f46"/>
          </linearGradient>
          <linearGradient id="sbMarkA" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6244D4"/>
            <stop offset="50%" stop-color="#7C69EC"/>
            <stop offset="100%" stop-color="#513AB0"/>
          </linearGradient>
          <linearGradient id="sbMarkB" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#A594FF"/>
            <stop offset="100%" stop-color="#8B7CF6"/>
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="64" height="64" rx="14" fill="url(#sbBg)"/>
        <rect x="12" y="30" width="16" height="24" rx="4" fill="url(#sbMarkA)"/>
        <rect x="34" y="20" width="16" height="34" rx="4" fill="url(#sbMarkA)" opacity="0.7"/>
        <rect x="24" y="10" width="16" height="28" rx="4" fill="url(#sbMarkB)"/>
      </svg>
      <span>Docs</span>
    </a>

    <nav class="sidebar-nav">
      {sections.map((section) => (
        <div class="sidebar-section">
          <p class="sidebar-section-title">{section.title}</p>
          <ul>
            {section.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["sidebar-link", { active: currentPath === item.href }]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    {toc.length > 0 && (
      <div class="sidebar-toc">
        <p class="sidebar-section-title">On this page</p>
        <ul>
          {toc.map((item) => (
            <li>
              <a href={`#${item.id}`} class="sidebar-toc-link">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</aside>

<style>
  .docs-sidebar {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    border-right: 1px solid var(--color-border);
  }

  .sidebar-inner {
    padding: 1.25rem 1rem;
    height: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    padding-bottom: 1.25rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-logo:hover {
    color: var(--color-accent);
  }

  .sidebar-nav {
    flex: 1;
  }

  .sidebar-section {
    margin-bottom: 1.5rem;
  }

  .sidebar-section-title {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    opacity: 0.6;
    padding: 0.375rem 0.625rem;
    margin-bottom: 0.25rem;
  }

  .sidebar-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-link {
    display: block;
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    color: var(--color-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
    line-height: 1.4;
  }

  .sidebar-link:hover {
    color: var(--color-primary);
    background: var(--color-surface);
  }

  .sidebar-link.active {
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.08);
  }

  .sidebar-toc {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .sidebar-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-toc-link {
    display: block;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    color: var(--color-secondary);
    opacity: 0.7;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
    line-height: 1.5;
  }

  .sidebar-toc-link:hover {
    color: var(--color-accent);
    opacity: 1;
    background: rgba(var(--color-accent-rgb), 0.05);
  }

  @media (max-width: 768px) {
    .docs-sidebar {
      display: none;
    }
  }
</style>
