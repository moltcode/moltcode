---
// Full-screen opening for the homepage: a burst of TV static that settles
// into the canvas grain, then the pinned post fades in on its own. The app
// shell only appears once you scroll past this.
---

<script is:inline>
  // Hide staggered pieces before first paint. Skipped for reduced motion,
  // and without JS nothing is ever hidden.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('reveal-on');
  }
</script>

<section class="intro" id="top">
  <canvas class="static" aria-hidden="true"></canvas>
  <div class="intro-inner">
    <slot />
  </div>
  <a href="#example" class="intro-cue" aria-label="Scroll to the thread">
    <span>Scroll</span>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
  </a>
</section>

<script>
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('.intro')!;
  const canvas = intro.querySelector<HTMLCanvasElement>('.static')!;
  const STATIC_MS = 900;

  const pieces = [
    ...intro.querySelectorAll('.fpost-avatar, .fpost-head, .fpost-body > *, .fpost-actions'),
    intro.querySelector('.intro-cue')!,
  ];
  pieces.forEach((el, i) => {
    el.classList.add('rv');
    (el as HTMLElement).style.setProperty('--rv-d', `${i * 90}ms`);
  });

  const reveal = () => pieces.forEach((el) => el.classList.add('in'));

  if (!root.classList.contains('reveal-on')) {
    canvas.remove();
  } else {
    // Low-res noise, scaled up with pixelated rendering so it reads as static.
    const ctx = canvas.getContext('2d')!;
    const w = (canvas.width = Math.ceil(innerWidth / 3));
    const h = (canvas.height = Math.ceil(innerHeight / 3));
    const img = ctx.createImageData(w, h);
    const px = new Uint32Array(img.data.buffer);
    const start = performance.now();

    const frame = (now: number) => {
      for (let i = 0; i < px.length; i++) {
        const v = (Math.random() * 255) | 0;
        px[i] = 0xff000000 | (v << 16) | (v << 8) | v;
      }
      ctx.putImageData(img, 0, 0);
      if (now - start < STATIC_MS + 700) requestAnimationFrame(frame);
      else canvas.remove();
    };
    requestAnimationFrame(frame);

    setTimeout(() => {
      canvas.classList.add('off');
      reveal();
    }, STATIC_MS);
  }
</script>

<style>
  .intro {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 6rem;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", system-ui, sans-serif;
    overflow: hidden;
  }

  .intro-inner {
    width: 100%;
    max-width: 58rem;
  }

  .intro-inner :global(.fpost) {
    border-bottom: 0;
    padding: 0;
  }

  .static {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0.55;
    transition: opacity 700ms ease, filter 700ms ease;
    pointer-events: none;
  }

  /* Scanlines over the noise. */
  .intro::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px);
    opacity: 0;
    transition: opacity 700ms ease;
  }

  :global(.reveal-on) .intro:has(.static:not(.off))::after { opacity: 1; }

  .static.off {
    opacity: 0;
    filter: blur(6px);
  }

  .intro-cue {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .intro-cue svg { animation: cue-bob 1.8s ease-in-out infinite; }

  .intro-cue:hover { color: var(--color-primary); }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-cue svg { animation: none; }
  }
</style>
