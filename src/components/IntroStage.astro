---
// Full-screen opening for the homepage: the app icon's tube at window size
// (warm black, coarse dim grain, an orange wash, scanlines, vignette and
// glare) with its voice line speaking across the middle. It fades as the
// line falls quiet, then the pinned post fades in on its own. The app
// shell only appears once you scroll past this.
---

<script is:inline>
  // Hide staggered pieces before first paint. Skipped for reduced motion,
  // and without JS nothing is ever hidden.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('reveal-on');
  }
</script>

<section class="intro" id="top">
  <canvas class="static" aria-hidden="true"></canvas>
  <canvas class="voice" aria-hidden="true"></canvas>
  <div class="intro-inner">
    <slot />
  </div>
  <a href="#example" class="intro-cue" aria-label="Scroll to the thread">
    <span>Scroll</span>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
  </a>
</section>

<script>
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('.intro')!;
  const canvas = intro.querySelector<HTMLCanvasElement>('.static')!;
  const voice = intro.querySelector<HTMLCanvasElement>('.voice')!;
  const STATIC_MS = 900;
  const VOICE_MS = STATIC_MS + 700;

  const pieces = [
    ...intro.querySelectorAll('.fpost-avatar, .fpost-head, .fpost-body > *, .fpost-actions'),
    intro.querySelector('.intro-cue')!,
  ];
  pieces.forEach((el, i) => {
    el.classList.add('rv');
    (el as HTMLElement).style.setProperty('--rv-d', `${i * 90}ms`);
  });

  const reveal = () => pieces.forEach((el) => el.classList.add('in'));

  // The app icon's trace at u (-1..1 across the screen), t seconds in:
  // quiet at the edges, loud in the middle. Same curve as the desktop boot.
  const voiceY = (u: number, t: number) => {
    const x = 512 + u * 452, k = x * 0.02, s = t * 5;
    const wob = 0.5 + 0.22 * Math.sin(k * 2.1 + s) + 0.16 * Math.sin(k * 5.3 - s * 1.7) + 0.12 * Math.sin(k * 11.7 + s * 2.3);
    return Math.exp(-u * u * 3.2) * (wob - 0.5) * 2 * Math.sin(x * 0.045 + t * 6);
  };

  const speak = () => {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = innerWidth, H = innerHeight;
    voice.width = Math.ceil(W * dpr);
    voice.height = Math.ceil(H * dpr);
    const g = voice.getContext('2d')!;
    g.scale(dpr, dpr);
    const t0 = performance.now();
    // A compact trace in the middle, not a screen-wide one.
    const half = Math.min(W * 0.22, 280);
    const amp = Math.min(H * 0.08, half * 0.3);
    const draw = (now: number) => {
      const v = Math.min((now - t0) / VOICE_MS, 1);
      g.clearRect(0, 0, W, H);
      const up = Math.max(0, 1 - (now - t0) / STATIC_MS);
      // The orange spilling off the line, the vignette and the glare.
      g.globalAlpha = 1;
      const wash = g.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, half * 1.25);
      wash.addColorStop(0, `rgba(255,106,19,${0.24 * up})`);
      wash.addColorStop(1, 'rgba(255,106,19,0)');
      g.save();
      g.translate(W / 2, H / 2);
      g.scale(1, Math.min(H * 0.14, half * 0.5) / (half * 1.25));
      g.translate(-W / 2, -H / 2);
      g.fillStyle = wash;
      g.fillRect(0, -H * 4, W, H * 9);
      g.restore();
      const vig = g.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, Math.hypot(W, H) / 2);
      vig.addColorStop(0.5, 'rgba(0,0,0,0)');
      vig.addColorStop(1, `rgba(0,0,0,${0.75 * up})`);
      g.fillStyle = vig;
      g.fillRect(0, 0, W, H);
      const glare = g.createLinearGradient(0, 0, W, H);
      glare.addColorStop(0, `rgba(255,255,255,${0.1 * up})`);
      glare.addColorStop(0.42, 'rgba(255,255,255,0)');
      g.fillStyle = glare;
      g.fillRect(0, 0, W, H);
      // Loud from the first beat, quiet as the static settles.
      const a = amp * Math.min((now - t0) / 150, 1) * (1 - v * v);
      g.beginPath();
      // The icon's sampling, so the trace keeps its spikes.
      for (let i = 0; i <= 113; i++) {
        const u = (i / 113) * 2 - 1;
        const y = H / 2 + a * voiceY(u, (now - t0) / 1000);
        i ? g.lineTo(W / 2 + u * half, y) : g.moveTo(W / 2 + u * half, y);
      }
      g.lineJoin = g.lineCap = 'round';
      g.globalAlpha = Math.min((now - t0) / 120, 1) * (1 - v * v);
      g.shadowColor = '#ff6a13';
      g.shadowBlur = 18;
      g.strokeStyle = '#ff6a13';
      g.lineWidth = 4;
      g.stroke();
      g.shadowBlur = 0;
      g.strokeStyle = '#ffe2c2';
      g.lineWidth = 1.4;
      g.stroke();
      if (v < 1) requestAnimationFrame(draw);
      else voice.remove();
    };
    requestAnimationFrame(draw);
  };

  if (!root.classList.contains('reveal-on')) {
    canvas.remove();
    voice.remove();
  } else {
    // The icon's coarse grain: one value per 8 px cell, each cell two
    // rows with the lower one dimmer, screened at 30 % over the warm tube.
    // Scaled up with pixelated rendering so it reads as static.
    const ctx = canvas.getContext('2d')!;
    const w = (canvas.width = Math.ceil(innerWidth / 8));
    const h = (canvas.height = Math.ceil(innerHeight / 4));
    const img = ctx.createImageData(w, h);
    const px = new Uint32Array(img.data.buffer);
    const start = performance.now();
    const TUBE = [26, 13, 6];
    let last = -1;

    const frame = (now: number) => {
      const tick = Math.floor((now - start) / 40);
      if (tick !== last) {
        last = tick;
        for (let y = 0; y < h; y += 2) {
          for (let x = 0; x < w; x++) {
            const v = Math.pow(Math.random(), 1.35) * 185 + 70;
            for (let r = 0; r < 2 && y + r < h; r++) {
              const a = (v / 255) * 0.3 * (r ? 0.55 : 1);
              const [cr, cg, cb] = TUBE.map((c) => Math.round(c + (255 - c) * a));
              px[(y + r) * w + x] = 0xff000000 | (cb << 16) | (cg << 8) | cr;
            }
          }
        }
        ctx.putImageData(img, 0, 0);
      }
      if (now - start < STATIC_MS + 700) requestAnimationFrame(frame);
      else canvas.remove();
    };
    requestAnimationFrame(frame);

    speak();
    setTimeout(() => {
      canvas.classList.add('off');
      reveal();
    }, STATIC_MS);
  }
</script>

<style>
  .intro {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 6rem;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", system-ui, sans-serif;
    overflow: hidden;
  }

  .intro-inner {
    width: 100%;
    max-width: 58rem;
  }

  .intro-inner :global(.fpost) {
    border-bottom: 0;
    padding: 0;
  }

  .static {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    transition: opacity 700ms ease, filter 700ms ease;
    pointer-events: none;
  }

  .voice {
    position: absolute;
    inset: 0;
    z-index: 7;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Scanlines over the noise. */
  .intro::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.3) 0 1px, transparent 1px 3px);
    opacity: 0;
    transition: opacity 700ms ease;
  }

  :global(.reveal-on) .intro:has(.static:not(.off))::after { opacity: 1; }

  .static.off {
    opacity: 0;
    filter: blur(6px);
  }

  .intro-cue {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .intro-cue svg { animation: cue-bob 1.8s ease-in-out infinite; }

  .intro-cue:hover { color: var(--color-primary); }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-cue svg { animation: none; }
  }
</style>
