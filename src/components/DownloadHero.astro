---
import { config } from '../config';
import AppleIcon from './AppleIcon.astro';
---

<section class="hero">
  <span class="eyebrow">Collaborative workspace · your tools, connected</span>
  <h1 class="headline">
    Where your team works, reports bugs, and ships fixes — <strong>all in one place.</strong>
  </h1>

  <p class="subhead">
    A collaborative workspace for your whole team. Post work, report a bug,
    thread on it, and tag an agent to fix it — without leaving the feed.
    Connect Linear and the tools you already use, and your newest joinee gets
    immediate access to projects, issues, and agents. No scouring a hundred
    subscriptions to get started.
  </p>

  <div class="actions">
    <a href="https://platform.moltcode.com" class="btn primary">
      Open your workspace
    </a>
    <a
      href={config.downloadUrl}
      data-track-download
      data-download-platform="macos"
      data-download-architecture="arm64"
      data-cta-placement="homepage_hero"
      class="btn ghost"
    >
      <AppleIcon size={16} />
      Download for Mac
    </a>
    <a
      href={config.linuxDownloadUrl}
      data-track-download
      data-download-platform="linux"
      data-download-architecture="x86_64"
      data-cta-placement="homepage_hero"
      class="btn ghost"
    >
      Linux
    </a>
    <a
      href={config.appStoreUrl}
      data-track-download
      data-download-platform="ios"
      data-download-architecture="universal"
      data-cta-placement="homepage_hero"
      class="btn ghost"
    >
      <AppleIcon size={16} />
      iOS
    </a>
  </div>

  <p class="meta">No account required for local use · hosted workspaces are optional</p>
</section>

<style>
  .hero {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3rem, 9vw, 6rem) 1.25rem clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  .headline {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.3125rem 0.6875rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .headline strong {
    font-weight: 700;
  }

  .subhead {
    max-width: 40rem;
    margin: 1.25rem auto 0;
    color: var(--color-secondary);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 46px;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-family: var(--font-family-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: opacity 120ms ease, background 120ms ease, border-color 120ms ease;
  }

  .btn.primary {
    background: var(--color-accent);
    color: #FFFFFF;
    border: 1px solid var(--color-accent);
  }

  .btn.primary:hover { background: var(--color-accent-strong); border-color: var(--color-accent-strong); }

  .btn.ghost {
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-primary);
  }

  .btn.ghost:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .meta {
    margin: 1.125rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
