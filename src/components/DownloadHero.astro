---
import { config } from '../config';
import AppleIcon from './AppleIcon.astro';
---

<section class="hero">
  <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Collaborative workspace · your tools, connected</span>
  <h1 class="headline">
    Molt + Your Browser = <strong>RSI</strong>
  </h1>

  <p class="subhead">
    Molt hands your agents your real browser. They open what they built, see what's broken, fix it, and check again. Every loop leaves the product better than the last.
  </p>

  <div class="actions">
    <a href="https://platform.moltcode.com" class="btn primary">
      Open your workspace
    </a>
    <a
      href={config.downloadUrl}
      data-track-download
      data-download-platform="macos"
      data-download-architecture="arm64"
      data-cta-placement="homepage_hero"
      class="btn ghost"
    >
      <AppleIcon size={16} />
      Download for Mac
    </a>
    <a
      href={config.linuxDownloadUrl}
      data-track-download
      data-download-platform="linux"
      data-download-architecture="x86_64"
      data-cta-placement="homepage_hero"
      class="btn ghost"
    >
      Linux
    </a>
  </div>

  <p class="meta">No account required for local use · hosted workspaces are optional</p>
</section>

<style>
  .hero {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3rem, 9vw, 6rem) 1.25rem clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  .headline {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-primary);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.3125rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-secondary);
    font-family: var(--font-family-mono);
    font-size: 11.5px;
    font-weight: 500;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-online);
  }

  .headline strong {
    font-weight: 700;
  }

  .subhead {
    max-width: 40rem;
    margin: 1.25rem auto 0;
    color: var(--color-secondary);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 42px;
    padding: 0 1.25rem;
    border-radius: 6px;
    font-family: var(--font-family-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: opacity 120ms ease, background 120ms ease, border-color 120ms ease;
  }

  .btn.primary {
    background: var(--color-ink-btn);
    color: var(--color-ink-btn-text);
    border: 1px solid var(--color-ink-btn);
  }

  .btn.primary:hover { opacity: 0.88; }

  .btn.ghost {
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    color: var(--color-primary);
  }

  .btn.ghost:hover { border-color: var(--color-primary); }

  .meta {
    margin: 1.25rem 0 0;
    font-family: var(--font-family-mono);
    font-size: 11.5px;
    color: var(--color-muted);
  }
</style>
