---
import { config } from '../config';
import AppleIcon from './AppleIcon.astro';
---

<section class="hero">
  <h1 class="headline">
    A simple, scalable UI for <strong>humans</strong> to invoke agents
  </h1>

  <div class="actions">
    <a href={config.downloadUrl} data-track-download class="btn primary">
      <AppleIcon size={16} />
      Download for Mac
    </a>
    <a href={config.linuxDownloadUrl} data-track-download class="btn ghost">
      Linux
    </a>
    <a href={config.appStoreUrl} class="btn ghost">
      <AppleIcon size={16} />
      iOS
    </a>
  </div>

  <p class="meta">macOS · Linux · iOS · free forever</p>
</section>

<style>
  .hero {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(3rem, 9vw, 6rem) 1.25rem clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  .headline {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-primary);
  }

  .headline strong {
    font-weight: 700;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 46px;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-family: var(--font-family-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: opacity 120ms ease, background 120ms ease, border-color 120ms ease;
  }

  .btn.primary {
    background: var(--color-accent);
    color: #FFFFFF;
    border: 1px solid var(--color-accent);
  }

  .btn.primary:hover { background: var(--color-accent-strong); border-color: var(--color-accent-strong); }

  .btn.ghost {
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-primary);
  }

  .btn.ghost:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .meta {
    margin: 1.125rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
