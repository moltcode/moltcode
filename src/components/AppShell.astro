    gap: 7px;
    padding: 5px 14px;
    color: rgba(214, 210, 201, 0.6);
    font-size: 12.5px;
    cursor: default;
  }

  .side-action:hover {
    color: var(--color-accent);
  }

  /* ===== Stage (main pane) ===== */
  .stage {
    flex: 1;
    min-width: 0;
