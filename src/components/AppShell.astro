---
import { config } from '../config';
import AppleIcon from './AppleIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

// ---------------------------------------------------------------------------
// Mirrors the desktop Explore view (compose_desktop shell/views/explore):
// a three-column X-style layout — 280 nav / 600 feed / 400 rail — on a
// lights-out canvas. Left nav = brand, Feed/Sessions, New session, destinations,
// projects, account. Center = sticky tabs, inline composer, stream cards.
// Right rail = search, "Continue working", "Most active".
// ---------------------------------------------------------------------------

const navPrimary = [
  { icon: 'home', label: 'Feed', active: true },
  { icon: 'activity', label: 'Sessions' },
];

const navDestinations = [
  { icon: 'electricity', label: 'MCP' },
  { icon: 'flash', label: 'Skills' },
  { icon: 'magicPen', label: 'Agents' },
  { icon: 'terminal', label: 'CLIs' },
  { icon: 'frame', label: 'Designs' },
  { icon: 'repeat', label: 'Workflows' },
];

// Scope monograms, as in ScopeNavRow — first letter over a chip circle.
const projects = [
  { name: 'cloud' },
  { name: 'molt' },
  { name: 'exploration' },
  { name: 'small_model' },
  { name: 'cve_mcp' },
];

// Stream cards: a "created" event is the user's root post, a "completed"
// event is the agent's conclusion replying to it.
const stream = [
  {
    kind: 'created',
    author: 'You',
    scope: 'm/molt',
    time: '2m',
    body: 'Wire the explore feed into the marketing site so the landing page is the product surface, not a screenshot of it.',
  },
  {
    kind: 'completed',
    author: 'Claude Opus',
    scope: 'm/cloud',
    time: '14m',
    body: 'Pushed the pod scheduler change — cold starts are down to 1.9s p95 and the warm pool holds through the deploy.',
    reply: 'can you make cloud pods spin up faster, the cold start is brutal',
  },
  {
    kind: 'completed',
    author: 'Codex',
    scope: 'm/cve_mcp',
    time: '1h',
    body: 'Scanned 412 dependencies, found 3 advisories with fixes available. Opened a PR pinning all three.',
    reply: 'audit the dependency tree for known CVEs',
  },
];

// Right rail "Continue working" — mirrors ContinuityRow archetypes.
const continuity = [
  { archetype: 'session', label: 'm/swiftui', meta: 'Running · 4m', title: 'Rebuild the settings sheet with the new segmented control', live: true },
  { archetype: 'file', label: 'ViewModel.kt', meta: '22m', title: 'modules/shell/src/main/kotlin/…/explore/data' },
  { archetype: 'workflow', label: 'Workflow', meta: 'completed · 1h', title: 'Nightly integration suite', steps: 3 },
  { archetype: 'terminal', label: 'Terminal', meta: 'live · 2h', title: 'pnpm dev', sub: 'cwd  ~/experiments/editor/website', live: true },
  { archetype: 'issue', label: 'ISS-2041', meta: 'high · open · 3h', title: 'Feed pagination drops the last page on fast scroll' },
];

const mostActive = [
  { name: 'molt', label: 'm/molt', count: 24 },
  { name: 'cloud', label: 'm/cloud', count: 11 },
  { name: 'exploration', label: 'm/exploration', count: 6 },
];

const icons: Record<string, string> = {
  home: '<path d="M3 11.2 12 3l9 8.2"/><path d="M5.5 9.8V21h13V9.8"/>',
  activity: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  electricity: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  flash: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  magicPen: '<path d="M15 4 4 15l5 5L20 9z"/><path d="m14 5 5 5"/><path d="M18 2v4M20 4h-4"/>',
  terminal: '<path d="m4 17 6-5-6-5"/><path d="M12 19h8"/>',
  frame: '<path d="M3 8h18M3 16h18M8 3v18M16 3v18"/>',
  repeat: '<path d="m17 2 4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>',
  sparkle: '<path d="M12 2.5 14.4 9 21 11.5 14.4 14 12 20.5 9.6 14 3 11.5 9.6 9z"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m21 16-5-5-6 6"/>',
  chatCircle: '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.3-.6L3 21l1.7-5a8.4 8.4 0 0 1-.7-3.4 8.4 8.4 0 0 1 8.5-8.5 8.4 8.4 0 0 1 8.5 8.4z"/>',
  file: '<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"/><path d="M14 2v5h5"/>',
  gitBranch: '<circle cx="6" cy="5" r="2.5"/><circle cx="6" cy="19" r="2.5"/><circle cx="18" cy="9" r="2.5"/><path d="M6 7.5v9M18 11.5a5 5 0 0 1-5 5H8"/>',
  taskSquare: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="m8 12 3 3 5-6"/>',
  caretDown: '<path d="m6 9 6 6 6-6"/>',
  chevronUp: '<path d="m18 15-6-6-6 6"/>',
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  list: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  upload: '<path d="M12 19V5M5 12l7-7 7 7"/>',
  sliders: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
};

const Icon = (name: string, size = 18) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;

const glyphFor = (archetype: string) =>
  ({ session: 'chatCircle', file: 'file', terminal: 'terminal', workflow: 'gitBranch', issue: 'taskSquare' } as Record<string, string>)[archetype] ?? 'activity';
---

<div class="desktop">
  <div class="window">
    <!-- Titlebar -->
    <div class="titlebar">
      <div class="traffic" aria-hidden="true">
        <span class="light red"></span>
        <span class="light yellow"></span>
        <span class="light green"></span>
      </div>
      <div class="titlebar-right">
        <a href="/pricing/" class="titlebar-link">pricing</a>
        <a href="/docs/what-is-moltcode/" class="titlebar-link">docs</a>
        <a href="https://platform.moltcode.com" class="titlebar-link">sign in</a>
        <span class="titlebar-sep" aria-hidden="true"></span>
        <ThemeToggle />
        <span class="titlebar-icon" set:html={Icon('upload', 15)} />
        <span class="titlebar-icon" set:html={Icon('sliders', 15)} />
        <span class="titlebar-icon" set:html={Icon('list', 15)} />
        <span class="titlebar-icon titlebar-user" set:html={Icon('user', 15)} />
      </div>
    </div>

    <!-- Explore's centered three-column block -->
    <div class="explore">
      <!-- Left nav (280) -->
      <nav class="leftnav" aria-label="Explore navigation">
        <div class="leftnav-scroll">
          <div class="brandmark" set:html={Icon('sparkle', 28)} />

          {navPrimary.map((item) => (
            <a href="#feed" class:list={['navrow', { selected: item.active }]}>
              <span class="navrow-icon"><Fragment set:html={Icon(item.icon, 24)} /></span>
              <span class="navrow-label">{item.label}</span>
            </a>
          ))}

          <a href={config.downloadUrl} data-track-download data-download-platform="macos" data-download-architecture="arm64" data-cta-placement="homepage_app_shell_new_session" class="newsession">New session</a>

          {navDestinations.map((item) => (
            <a href="/docs/features/" class="navrow">
              <span class="navrow-icon"><Fragment set:html={Icon(item.icon, 24)} /></span>
              <span class="navrow-label">{item.label}</span>
            </a>
          ))}

          <p class="nav-section">Projects</p>
          {projects.map((p) => (
            <div class="scoperow">
              <span class="monogram">{p.name.charAt(0).toUpperCase()}</span>
              <span class="scoperow-name">{p.name}</span>
            </div>
          ))}
          <div class="scoperow">
            <span class="monogram monogram-plus" set:html={Icon('plus', 14)} />
            <span class="scoperow-name">Add project</span>
          </div>
        </div>

        <div class="accountrow">
          <span class="account-avatar">Y</span>
          <span class="account-id">
            <span class="account-name">you</span>
            <span class="account-path">~/experiments/editor</span>
          </span>
        </div>
      </nav>

      <span class="hairline" aria-hidden="true"></span>

      <!-- Feed (600) -->
      <main class="feed" id="feed">
        <div class="feed-tabs">
          <div class="feed-tab active"><span>Feed</span></div>
          <div class="feed-tab"><span>Sessions</span></div>
        </div>

        <!-- Inline composer, doubling as the page's hero + download CTA -->
        <section class="composer">
          <span class="composer-avatar">Y</span>
          <div class="composer-body">
            <h1 class="composer-headline">
              <span data-typed-headline>Leave your laptop at home</span><span class="caret"></span>
            </h1>
            <p class="composer-sub">
              The same dev workspace on desktop, iPad, and phone. Spec a PRD, agents resolve it —
              you review the diffs from anywhere.
            </p>
            <div class="composer-actions">
              <span class="composer-tools" aria-hidden="true">
                <span set:html={Icon('image', 18)} />
                <span set:html={Icon('frame', 18)} />
                <span set:html={Icon('terminal', 18)} />
              </span>
              <a href={config.downloadUrl} data-track-download data-download-platform="macos" data-download-architecture="arm64" data-cta-placement="homepage_app_shell_composer" class="post-btn">
                <AppleIcon size={14} />
                Download for Mac
              </a>
              <a href={config.appStoreUrl} data-track-download data-download-platform="ios" data-download-architecture="universal" data-cta-placement="homepage_app_shell_composer" class="post-btn ghost">
                <AppleIcon size={14} />
                iOS
              </a>
            </div>
          </div>
        </section>

        <!-- Stream -->
        {stream.map((item) => (
          <article class="streamcard">
            <span class:list={['stream-avatar', { agent: item.kind === 'completed' }]}>
              {item.kind === 'completed' ? item.author.charAt(0) : 'Y'}
            </span>
            <div class="stream-body">
              <div class="stream-head">
                <span class="stream-author">{item.author}</span>
                <span class="scope-handle">{item.scope}</span>
                <span class="stream-dot">·</span>
                <span class="stream-time">{item.time}</span>
              </div>
              <p class="stream-text">{item.body}</p>
              {item.reply && (
                <div class="reply-context">
                  <span class="reply-label">In reply to You</span>
                  <span class="reply-text">{item.reply}</span>
                </div>
              )}
              <div class="stream-actions">
                <span class="stream-action">
                  <Fragment set:html={Icon('chatCircle', 16)} />
                  <span>Open thread</span>
                </span>
              </div>
            </div>
          </article>
        ))}

        <!-- Marketing content continues inside the feed column -->
        <div class="feed-content">
          <slot />
        </div>
      </main>

      <span class="hairline" aria-hidden="true"></span>

      <!-- Right rail (400) -->
      <aside class="rightrail" aria-label="Activity">
        <div class="searchbox">
          <span class="search-icon" set:html={Icon('search', 15)} />
          <span class="search-placeholder">Search</span>
        </div>

        <section class="railcard">
          <div class="railcard-head">
            <h2>Continue working</h2>
            <span class="filter-menu">
              <span>All</span>
              <Fragment set:html={Icon('caretDown', 13)} />
            </span>
          </div>
          <div class="railcard-body">
            {continuity.map((row) => (
              <div class:list={['continuity-row', `k-${row.archetype}`]}>
                {row.archetype === 'session' ? (
                  <span class="continuity-avatar">C</span>
                ) : (
                  <span class="continuity-glyph"><Fragment set:html={Icon(glyphFor(row.archetype), 18)} /></span>
                )}
                <div class="continuity-main">
                  <div class="byline">
                    <span class="byline-label">{row.label}</span>
                    {row.live && <span class="live-dot" aria-hidden="true"></span>}
                    <span class="byline-meta">· {row.meta}</span>
                  </div>
                  <p class="continuity-title">{row.title}</p>
                  {row.sub && <p class="continuity-sub mono">{row.sub}</p>}
                  {row.steps && (
                    <div class="wf-progress" aria-hidden="true">
                      <span class="wf-step on"></span><span class="wf-dash">—</span>
                      <span class="wf-step on"></span><span class="wf-dash">—</span>
                      <span class="wf-step on"></span>
                      <span class="wf-label">Completed</span>
                    </div>
                  )}
                </div>
              </div>
            ))}
            <div class="loadmore">Load more</div>
          </div>
        </section>

        <section class="railcard">
          <div class="railcard-head"><h2>Most active</h2></div>
          <div class="railcard-body">
            {mostActive.map((s) => (
              <div class="scopecard-row">
                <span class="monogram lg">{s.name.charAt(0).toUpperCase()}</span>
                <div class="scopecard-main">
                  <span class="scopecard-name">{s.name}</span>
                  <span class="scopecard-meta">{s.label} · {s.count} sessions</span>
                </div>
                <span class="pill-btn">View</span>
              </div>
            ))}
          </div>
        </section>
      </aside>
    </div>

    <!-- Status bar -->
    <div class="statusbar">
      <div class="statusbar-left">
        <span set:html={Icon('monitor', 13)} />
        <span>moltcode v{config.version}</span>
      </div>
      <div class="statusbar-right">
        <span set:html={Icon('list', 13)} />
        <span>Processes</span>
        <span set:html={Icon('chevronUp', 12)} />
      </div>
    </div>
  </div>
</div>

<script>
  const headline = document.querySelector<HTMLElement>('[data-typed-headline]');

  if (headline && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const phrases = [
      'Leave your laptop at home',
      'Access from anywhere',
      'Highly scalable workspace for teams',
      'and individuals',
    ];
    const typeDelay = 54;
    const deleteDelay = 28;
    const holdDelay = 1400;
    let phraseIndex = 0;

    const sleep = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

    const typePhrase = async (phrase: string) => {
      for (let i = 1; i <= phrase.length; i += 1) {
        headline.textContent = phrase.slice(0, i);
        await sleep(typeDelay);
      }
    };

    const deletePhrase = async () => {
      const phrase = headline.textContent ?? '';
      for (let i = phrase.length; i >= 0; i -= 1) {
        headline.textContent = phrase.slice(0, i);
        await sleep(deleteDelay);
      }
    };

    const runTypingLoop = async () => {
      headline.textContent = phrases[0];

      while (true) {
        await sleep(holdDelay);
        await deletePhrase();
        phraseIndex = (phraseIndex + 1) % phrases.length;
        await typePhrase(phrases[phraseIndex]);
      }
    };

    runTypingLoop();
  }
</script>

<style>
  /* ===== Explore palette ==================================================
     Dark goes "lights out" — pure-black canvas and tonal chips, no raised
     surfaces. Light keeps the site's normal warm scheme, exactly as
     ExploreContent scopes its override to `isDark`.
     ====================================================================== */
  .desktop {
    --ex-surface: #000000;
    --ex-ink: #e7e9ea;
    --ex-ink2: #b6bcc2;
    --ex-ink3: #71767b;
    --ex-ink4: #5b6167;
    --ex-border: #212427;
    --ex-chip: #16181c;
    --ex-hover: rgba(231, 233, 234, 0.03);
    --ex-brand: var(--color-accent);
    --ex-inverse: var(--ex-surface);
    --ex-agent-fill: linear-gradient(160deg, #33261a, #221a12);
    --ex-railcard: rgba(22, 24, 28, 0.5);
    --ex-tabs-bg: rgba(0, 0, 0, 0.72);
    --ex-link: #60a5fa;
    --ex-accent-file: #2dd4a7;
    --ex-accent-terminal: #55b7f2;
    --ex-accent-workflow: #a78bfa;
    --ex-accent-issue: #60a5fa;

    height: 100dvh;
    padding: clamp(0px, 2vw, 26px);
    box-sizing: border-box;
    display: flex;
  }

  :global([data-theme='light']) .desktop {
    --ex-surface: #ffffff;
    --ex-ink: #0f1419;
    --ex-ink2: #536471;
    --ex-ink3: #75828d;
    --ex-ink4: #8b98a5;
    --ex-border: #eff3f4;
    --ex-chip: #f1f3f4;
    --ex-hover: rgba(15, 20, 25, 0.03);
    --ex-inverse: #ffffff;
    --ex-agent-fill: linear-gradient(160deg, #f8e6d6, #f1d8c2);
    --ex-railcard: #f7f9f9;
    --ex-tabs-bg: rgba(255, 255, 255, 0.85);
    --ex-link: #1d6fd0;
    --ex-accent-file: #0f9b76;
    --ex-accent-terminal: #1f77c4;
    --ex-accent-workflow: #7a4fd6;
    --ex-accent-issue: #1d6fd0;
  }

  .window {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--ex-surface);
    border: 1px solid var(--ex-border);
    border-radius: clamp(0px, 1.5vw, 14px);
    overflow: hidden;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
    color: var(--ex-ink);
    font-family: var(--font-family-sans);
    font-size: 14px;
  }

  /* ===== Titlebar ===== */
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid var(--ex-border);
    background: var(--ex-surface);
    flex-shrink: 0;
  }

  .traffic { display: flex; gap: 8px; }
  .light { width: 12px; height: 12px; border-radius: 50%; }
  .light.red { background: #ff5f57; }
  .light.yellow { background: #febc2e; }
  .light.green { background: #28c840; }

  .titlebar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ex-ink3);
  }

  .titlebar-link {
    font-size: 12px;
    color: var(--ex-ink2);
    transition: color 120ms ease;
  }

  .titlebar-link:hover { color: var(--ex-brand); }

  .titlebar-sep { width: 1px; height: 14px; background: var(--ex-border); }
  .titlebar-icon { display: inline-flex; }

  .titlebar-user {
    padding: 3px;
    border: 1px solid var(--ex-border);
    border-radius: 6px;
  }

  /* ===== Three-column block: 280 | 600 | 400, centered ===== */
  .explore {
    flex: 1;
    min-height: 0;
    display: flex;
    justify-content: center;
    background: var(--ex-surface);
  }

  .hairline {
    width: 1px;
    flex-shrink: 0;
    background: var(--ex-border);
  }

  /* ===== Left nav ===== */
  .leftnav {
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .leftnav-scroll {
    flex: 1;
    /* Without this the nav's content height wins the flex negotiation and the
       pinned account row below is pushed over the last scope rows. */
    min-height: 0;
    overflow-y: auto;
    padding: 8px 20px 8px 12px;
  }

  .brandmark {
    display: inline-flex;
    padding: 8px 0 8px 12px;
    color: var(--ex-ink);
  }

  /* X nav rows: tall, full-round hover pill, bold when active */
  .navrow {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 12px 24px 12px 12px;
    border-radius: 999px;
    color: var(--ex-ink);
    transition: background 120ms ease;
  }

  .navrow:hover { background: var(--ex-hover); }
  .navrow-icon { display: inline-flex; }
  .navrow-label { font-size: 19px; font-weight: 400; }
  .navrow.selected .navrow-label { font-weight: 800; }

  /* Inverse monochrome pill, like X's post button */
  .newsession {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    margin: 12px 0;
    border-radius: 999px;
    background: var(--ex-ink);
    color: var(--ex-inverse);
    font-size: 19px;
    font-weight: 500;
    transition: background 120ms ease;
  }

  .newsession:hover { opacity: 0.85; }

  .nav-section {
    margin: 16px 0 6px;
    padding-left: 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ex-ink4);
  }

  .scoperow {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 999px;
    color: var(--ex-ink);
    font-size: 15px;
    transition: background 120ms ease;
  }

  .scoperow:hover { background: var(--ex-hover); }

  .scoperow-name {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .monogram {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ex-chip);
    color: var(--ex-ink2);
    font-size: 13px;
    font-weight: 600;
  }

  .monogram.lg { width: 36px; height: 36px; font-size: 15px; }

  .accountrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 24px;
    /* The scope list scrolls under this pinned row; the rule keeps the two
       readable as separate regions instead of a collision. */
    border-top: 1px solid var(--ex-border);
    background: var(--ex-surface);
  }

  .account-avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ex-chip);
    color: var(--ex-ink2);
    font-size: 14px;
    font-weight: 600;
  }

  .account-id { display: flex; flex-direction: column; min-width: 0; }
  .account-name { font-size: 15px; font-weight: 600; color: var(--ex-ink); }

  .account-path {
    font-size: 13px;
    color: var(--ex-ink3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ===== Feed column ===== */
  .feed {
    width: 600px;
    max-width: 600px;
    flex: 1 1 600px;
