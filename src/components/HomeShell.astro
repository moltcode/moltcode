---
// A mock of the Molt Code desktop app window, drawn to match the real app:
// traffic-light title bar, the ⌘1–⌘8 workspace rail, the app sidebar (Feed,
// streams, archetypes, projects), the Post pane holding the page content as a
// thread, and the "In this thread" rail. The chrome is decorative; only the
// timeline links and the theme toggle do anything.
import ThemeToggle from './ThemeToggle.astro';

const icons: Record<string, string> = {
  home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
  chat: 'M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-5.1A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z',
  pin: 'M9 3h6l-1 6 4 3v2H6v-2l4-3zM12 14v7',
  pulse: 'M3 12h4l3-7 4 14 3-7h4',
  bell: 'M4 6h16v12H4zM4 7l8 6 8-6',
  oracle: 'M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8z',
  wand: 'M15 4V2M15 10V8M11 6h2M17 6h2M4 20 14 10M18 13v2M17 14h2',
  folder: 'M3 6h6l2 2h10v11H3z',
  search: 'M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14zM21 21l-5-5',
  branch: 'M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a9 9 0 0 1-9 9',
  term: 'M4 17l6-5-6-5M12 19h8',
  code: 'M9 7l-5 5 5 5M15 7l5 5-5 5',
  health: 'M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18zM8 12h2l1-3 2 6 1-3h2',
  plus: 'M12 5v14M5 12h14',
  chevron: 'M9 6l6 6-6 6',
  down: 'M6 9l6 6 6-6',
  back: 'M15 6l-6 6 6 6',
  file: 'M14 3H6v18h12V7zM14 3v4h4',
  image: 'M4 4h16v16H4zM4 16l5-5 5 5M14 14l2-2 4 4M9 9h.01',
  at: 'M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-3.5 7.1',
  hash: 'M5 9h14M5 15h14M10 3 8 21M16 3l-2 18',
  monitor: 'M3 4h18v12H3zM8 20h8M12 16v4',
  zoom: 'M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14zM21 21l-5-5M11 8v6M8 11h6',
  up: 'M12 19V5M6 11l6-6 6 6',
  gear: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z',
  checks: 'M3 6l2 2 3-3M3 13l2 2 3-3M11 7h10M11 14h10M11 20h10',
  apps: 'M4 4h6v6H4zM4 14h6v6H4zM14 14h6v6h-6zM17 4a3 3 0 1 1 0 6 3 3 0 0 1 0-6z',
  stream: 'M3 6h6l2 2h10v11H3zM12 11v5M9.5 13.5h5',
  refresh: 'M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6',
  dots: 'M12 5h.01M12 12h.01M12 19h.01',
  session: 'M7 17L17 7M9 7h8v8',
  save: 'M6 3h12v18l-6-4-6 4z',
};

const nav = [
  { label: 'Feed', icon: 'home', count: '15', active: true },
  { label: 'Pinned', icon: 'pin' },
  { label: 'Sessions', icon: 'pulse' },
  { label: 'Notifications', icon: 'bell' },
  { label: 'Oracles', icon: 'oracle' },
  { label: 'Agents', icon: 'wand' },
  { label: 'More', icon: 'down', count: '6' },
];

const projects = [
  { letter: 'M', label: 'Moltcode', meta: '6 tools' },
  { letter: 'S', label: 'Shell Harness', meta: '6 tools' },
  { letter: 'W', label: 'Website', meta: '6 tools', open: true },
];

const projectTools = [
  { label: 'Files', icon: 'folder' },
  { label: 'Search', icon: 'search' },
  { label: 'Git', icon: 'branch' },
  { label: 'Terminals', icon: 'term', count: '0', caret: true },
  { label: 'Processes', icon: 'code', count: '0', caret: true, open: true },
];

const timeline = [
  { n: '01', id: 'top', name: 'Molt Code', chip: 'Pinned', when: 'now', text: 'Your browser is your agents\' IDE. Where your team works, reports bugs, and ships fixes.', files: ['Download for Mac', 'Linux'] },
  { n: '02', id: 'example', name: 'Fable', tone: 'blue', initial: 'F', chip: 'Done', when: '1m', text: 'Cold starts were serialising on image pull. p95 down from 8.4s to 1.9s.', files: ['pods/scheduler.go'] },
  { n: '03', id: 'integrations', name: 'Molt Code', chip: 'Needs review', when: '4m', text: 'No integration to install. Agents use your tools the way you do: CLI, browser, app UI, MCP.', files: ['Integrations — dark', 'Integrations — light'] },
  { n: '04', id: 'workspace', name: 'Molt Code', chip: 'Needs review', when: '9m', text: 'Pick up the thread, not the whole computer. Hosted workspaces keep the conversation.' },
  { n: '05', id: 'flow', name: 'Molt Code', chip: 'Needs review', when: '13m', text: 'Post. Thread. Tag an agent. The thread is the input, the reply is the return value.' },
  { n: '06', id: 'agents', name: 'Molt Code', chip: 'Needs review', when: '27m', text: 'Pick the harness, pick the model, write the instructions. Call it by @handle.', files: ['Agents'] },
];

const fileCount = timeline.reduce((n, t) => n + (t.files?.length ?? 0), 0);
---

<div class="shell">
  <!-- ===== Title bar ===== -->
  <header class="titlebar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="tb-tab">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d={icons.chat} /></svg>
      <span>Your browser is you…</span>
    </span>
    <span class="tb-plus" aria-hidden="true">+</span>
    <span class="tb-spacer"></span>
    <div class="tb-icons">
      {['monitor', 'zoom'].map((i) => (
        <span class="tb-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]} /></svg></span>
      ))}
      <ThemeToggle />
      {['up', 'gear', 'checks', 'pulse'].map((i) => (
        <span class="tb-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]} /></svg></span>
      ))}
      <span class="tb-me" aria-hidden="true">M</span>
    </div>
  </header>

  <!-- ===== ⌘ workspace rail ===== -->
  <nav class="cmd" aria-hidden="true">
    {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
      <span class:list={['cmd-key', { active: n === 7 }]}>⌘{n}</span>
    ))}
    <span class="cmd-sep"></span>
    <span class="cmd-key plus"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d={icons.plus} /></svg></span>
    <span class="tb-spacer"></span>
    <span class="cmd-key apps"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={icons.apps} /></svg></span>
  </nav>

  <!-- ===== Sidebar ===== -->
  <aside class="side" aria-hidden="true">
    <div class="side-scroll">
      <div class="side-title">Molt</div>

      <div class="side-nav">
        {nav.map((item) => (
          <span class:list={['side-item', { active: item.active }]}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[item.icon]} /></svg>
            <span>{item.label}</span>
            {item.count && <span class="side-count">{item.count}</span>}
          </span>
        ))}
      </div>

      <div class="side-group">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.chevron} /></svg>
        <span>Streams</span>
        <svg class="side-group-act" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d={icons.stream} /></svg>
      </div>

      <div class="side-group">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.down} /></svg>
        <span>Archetypes</span>
      </div>
      <span class="side-item add">
        <span class="side-add"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d={icons.plus} /></svg></span>
        <span>Add archetype</span>
      </span>

      <div class="side-group">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.down} /></svg>
        <span>Projects</span>
        <svg class="side-group-act" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons.refresh} /></svg>
      </div>
      <div class="side-nav">
        {projects.map((p) => (
          <>
            <span class="side-item project">
              <svg class="side-chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><path d={p.open ? icons.down : icons.chevron} /></svg>
              <span class="side-letter">{p.letter}</span>
              <span>{p.label}</span>
              <span class="side-meta">{p.meta}</span>
              <svg class="side-dots" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d={icons.dots} /></svg>
            </span>
            {p.open && projectTools.map((t) => (
              <>
                <span class="side-item tool">
                  {t.caret
                    ? <svg class="side-chev" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"><path d={t.open ? icons.down : icons.chevron} /></svg>
                    : <span class="side-chev"></span>}
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[t.icon]} /></svg>
                  <span>{t.label}</span>
                  {t.count && <span class="side-count plain">{t.count}</span>}
                </span>
                {t.open && <span class="side-empty">No processes</span>}
              </>
            ))}
            {p.open && (
              <span class="side-item tool">
                <span class="side-chev"></span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons.health} /></svg>
                <span>Code health</span>
              </span>
            )}
          </>
        ))}
        <span class="side-item add">
          <span class="side-add"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d={icons.plus} /></svg></span>
          <span>Add project</span>
        </span>
      </div>
    </div>

    <div class="side-foot">
      <span class="side-cta">New session <span class="side-kbd">⌘N</span></span>
      <span class="side-user">
        <span class="side-avatar">M</span>
        <span class="side-user-text">
          <span class="side-user-name">Maya Chen</span>
          <span class="side-user-meta">maya@acme.dev</span>
        </span>
      </span>
    </div>
  </aside>

  <!-- ===== Center: the Post pane ===== -->
  <main class="center">
    <div class="center-head">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icons.back} /></svg>
      <span class="center-title">Post</span>
      <span class="tb-spacer"></span>
      <span class="center-action" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><path d={icons.oracle} /></svg>
        Start oracle
      </span>
    </div>

    <div class="center-feed">
      <slot />
    </div>

    <div class="composer" aria-hidden="true">
      <span class="composer-field">Reply to @molt</span>
      <div class="composer-row">
        {['image', 'file', 'at', 'hash'].map((i) => (
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]} /></svg>
        ))}
        <span class="tb-spacer"></span>
        <span class="composer-send">Reply</span>
      </div>
    </div>
  </main>

  <!-- ===== Right rail: In this thread ===== -->
  <aside class="rail" aria-label="In this thread">
    <div class="rail-scroll">
      <div class="rail-head">
        <div>
          <div class="rail-title">In this thread</div>
          <div class="rail-sub">Whole thread · {timeline.length} posts</div>
        </div>
        <span class="rail-count">{fileCount} files · 1 image</span>
      </div>

      <div class="rail-pills" aria-hidden="true">
        <span class="pill active">All</span>
        <span class="pill">Files {fileCount}</span>
        <span class="pill">Images 1</span>
      </div>

      <div class="rail-label">Open</div>
      <a href="#integrations" class="rail-open">
        <span class="rchip">Needs review</span>
        <span class="rail-open-text">
          No integration to install. Agents use your tools the way you do: CLI, browser, app UI, MCP.
          <span class="rail-by">Molt Code · #03</span>
        </span>
      </a>

      <div class="rail-label">Timeline</div>
      <ol class="tl">
        {timeline.map((t) => (
          <li class="tl-item" data-spy={t.id}>
            <span class="tl-n">{Number(t.n)}</span>
            <a href={`#${t.id}`} class="tl-body">
              <span class="tl-head">
                {t.initial
                  ? <span class="tl-avatar" data-tone={t.tone}>{t.initial}</span>
                  : <img class="tl-avatar" src="/brand-icon-64.png" alt="" width="18" height="18" />}
                <span class="tl-name">{t.name}</span>
                <span class="rchip">{t.chip}</span>
                <span class="tb-spacer"></span>
                <span class="tl-ord">#{t.n} · {t.when}</span>
              </span>
              <span class="tl-text">{t.text}</span>
              {t.files && (
                <span class="tl-files">
                  {t.files.map((f) => (
                    <span class="tl-file">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d={icons.file} /></svg>
                      {f}
                    </span>
                  ))}
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="rail-foot" aria-hidden="true">
      <span class="rail-dot"></span>
      3 just finished in other threads
    </div>
  </aside>
</div>

<script>
  // The window frames in as the intro scrolls away, its chrome staggers in,
  // each post reveals piece by piece on scroll, and the post you're reading
  // gets the app's selected fill with its timeline row lit.
  const root = document.documentElement;
  const STEP = 40;

  const stagger = (els: Element[], start = 0) =>
    els.forEach((el, i) => {
      el.classList.add('rv');
      (el as HTMLElement).style.setProperty('--rv-d', `${start + i * STEP}ms`);
    });

  // Blocks inside a post body: walk past single-child wrappers, then expand
  // grids and "-copy" columns so cards and paragraphs arrive one by one.
  const postPieces = (post: Element) => {
    const out: Element[] = [];
    const head = post.querySelector('.fpost-head');
    if (head) out.push(head);
    let el = post.querySelector('.fpost-body') ?? post;
    while (el.children.length === 1) el = el.children[0];
    for (const child of Array.from(el.children)) {
      const expand = getComputedStyle(child).display === 'grid' || /-copy\b/.test(child.className);
      out.push(...(expand && child.children.length > 1 ? Array.from(child.children) : [child]));
    }
    const actions = post.querySelector('.fpost-actions');
    if (actions) out.push(actions);
    return out;
  };

  const shell = document.querySelector<HTMLElement>('.shell')!;
  const posts = Array.from(document.querySelectorAll('.center-feed > .fpost, .center-feed > .feed-block'));

  if (root.classList.contains('reveal-on')) {
    stagger(Array.from(document.querySelectorAll('.titlebar > *')));
    stagger(Array.from(document.querySelectorAll('.cmd > *')), 60);
    stagger(Array.from(document.querySelectorAll('.side-title, .side-nav > *, .side-group, .side-foot > *')), 100);
    stagger([document.querySelector('.center-head')!].filter(Boolean), 160);
    stagger(Array.from(document.querySelectorAll('.rail-head, .rail-pills, .rail-label, .rail-open, .tl-item, .rail-foot')), 200);
    const composer = document.querySelector('.composer');
    if (composer) stagger([composer], 360);
    posts.forEach((post) => stagger(postPieces(post)));
    const chrome = document.querySelectorAll('.titlebar .rv, .cmd .rv, .side .rv, .rail .rv, .center-head.rv, .composer.rv');

    // Scale and fade track scroll progress (--p goes 0 -> 1) as the window
    // rises into view.
    shell.classList.add('framed');
    let chromeIn = false;
    const track = () => {
      const top = shell.getBoundingClientRect().top;
      const p = Math.min(1, Math.max(0, 1 - top / innerHeight));
      shell.style.setProperty('--p', p.toFixed(3));
      shell.classList.toggle('settled', p >= 1);
      if (!chromeIn && p > 0.3) {
        chromeIn = true;
        chrome.forEach((el) => el.classList.add('in'));
      }
    };
    addEventListener('scroll', () => requestAnimationFrame(track), { passive: true });
    addEventListener('resize', track);
    track();

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.querySelectorAll('.rv').forEach((el) => el.classList.add('in'));
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
    );
    posts.forEach((post) => io.observe(post));
  }

  // Scrollspy: the post crossing the upper third of the viewport is "open".
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.tl-item[data-spy]'));
  const targets = rows.map((li) => document.getElementById(li.dataset.spy!)).filter((el): el is HTMLElement => !!el);
  const postOf = (el: HTMLElement) => el.closest('.fpost, .feed-block');
  const setActive = (id: string) => {
    rows.forEach((li) => li.classList.toggle('active', li.dataset.spy === id));
    const current = document.getElementById(id);
    posts.forEach((p) => p.classList.toggle('selected', !!current && postOf(current) === p));
  };
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      const line = innerHeight * 0.35;
      let current = targets[0]?.id;
      for (const t of targets) if (t.getBoundingClientRect().top - line <= 0) current = t.id;
      if (current) setActive(current);
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  /* ===== Motion ===== */
  :global(.reveal-on) :global(.rv) {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(3px);
  }

  :global(.reveal-on) :global(.side .rv),
  :global(.reveal-on) :global(.cmd .rv) { transform: translateX(-10px); }
  :global(.reveal-on) :global(.rail .rv) { transform: translateX(10px); }
  :global(.reveal-on) :global(.titlebar .rv) { transform: translateY(-6px); }

  :global(.reveal-on) :global(.rv.in) {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 520ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--rv-d, 0ms),
      transform 620ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--rv-d, 0ms),
      filter 520ms ease var(--rv-d, 0ms);
  }

  /* Window entrance, driven by --p from the scroll handler. */
  .shell.framed:not(.settled) {
    transform: scale(calc(0.92 + 0.08 * var(--p, 0)));
    transform-origin: 50% 0;
    opacity: calc(0.2 + 0.8 * var(--p, 0));
  }

  /* ===== Window ===== */
  .shell {
    --cmd-w: 46px;
    --side-w: 252px;
    --rail-w: 360px;
    --bar-h: 38px;
    --font-family-sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", system-ui, sans-serif;
    font-family: var(--font-family-sans);
    font-size: 13px;
    display: grid;
    grid-template-columns: var(--cmd-w) var(--side-w) minmax(0, 1fr) var(--rail-w);
    grid-template-rows: var(--bar-h) auto;
    min-height: 100vh;
    margin: 0 1.25rem;
    border: 1px solid var(--shell-line);
    border-radius: 12px;
    background: var(--color-bg);
    box-shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.55), 0 0 0 0.5px rgba(0, 0, 0, 0.2);
    overflow-x: clip;
  }

  .tb-spacer { flex: 1; }

  /* ===== Title bar ===== */
  .titlebar {
    grid-column: 1 / -1;
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.75rem 0 0.875rem;
    height: var(--bar-h);
    background: var(--color-bg);
    border-bottom: 1px solid var(--shell-line);
    border-radius: 12px 12px 0 0;
  }

  .lights {
    display: flex;
    gap: 8px;
    margin-right: 0.5rem;
  }

  .lights i {
