---
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <span class="nav-mark" aria-hidden="true">M</span>
      <span class="nav-name">moltcode</span>
    </a>

    <div class="nav-links">
      <ThemeToggle />
      <a href="/pricing/" class="nav-link">pricing</a>
      <a href="/docs/what-is-moltcode/" class="nav-link">docs</a>
      <a href="https://platform.moltcode.com" class="nav-link nav-link-accent">workspace</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .nav-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .nav-inner {
      padding: 0.75rem 2rem;
    }
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-family-sans);
    font-size: 14px;
    font-weight: 650;
    color: var(--color-primary);
  }

  /* Squircle mark, matching the app's project avatars */
  .nav-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: linear-gradient(160deg, #8B7CF6, #6244D4);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .nav-name {
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.4375rem 0.75rem;
    font-family: var(--font-family-sans);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-secondary);
    border-radius: 999px;
    transition: color 120ms ease, background 120ms ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link-accent {
    background: var(--color-accent);
    color: #FFFFFF;
    font-weight: 600;
  }

  .nav-link-accent:hover {
    background: var(--color-accent-strong);
    color: #FFFFFF;
  }

  @media (max-width: 540px) {
    .nav-link:not(.nav-link-accent):not(.theme-toggle) {
      display: none;
    }
  }
</style>
