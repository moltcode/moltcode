---
// ---------------------------------------------------------------------------
// A static replica of a real chat session turn, mirroring the desktop app
// (compose_desktop chat_ui/views/chat_session):
//   - user turn  = right-aligned rounded bubble (_UserBubble)
//   - agent turn = flush-left, no container, 585px prose (_AssistantBubble)
//   - tool steps = 12px ringed dot in an 18px gutter with 1.5px connectors
//                  (StepperItem), grouped tool cards at 12px radius
// Geometry constants are lifted from ChatTurnStyles / StepperItem so the page
// and the app read as the same surface.
// ---------------------------------------------------------------------------

const steps = [
  { label: 'Read', params: 'PodScheduler.kt', done: true },
  { label: 'Grep', params: '"warmPool" · 14 matches', done: true },
  { label: 'Edit', params: 'PodScheduler.kt +38 −11', done: true },
  { label: 'Bash', params: './gradlew :cloud:test', done: true },
];
---

<section class="chat" aria-label="Example agent session">
  <!-- User turn -->
  <div class="turn user">
    <div class="bubble">can you make cloud pods spin up faster, the cold start is brutal</div>
  </div>

  <!-- Agent turn -->
  <div class="turn agent">
    <div class="prose">
      <div class="byline">
        <span class="avatar">C</span>
        <span class="who">Claude Opus</span>
        <span class="meta">· m/cloud</span>
      </div>

      <p class="text">
        Cold starts were serialising on image pull. I moved the pull ahead of the
        scheduling decision and kept a warm pool of three pods per region.
      </p>

      <div class="toolcard">
        {steps.map((step, i) => (
          <div class:list={['step', { first: i === 0, last: i === steps.length - 1 }]}>
            <span class="gutter" aria-hidden="true"><span class="dot"></span></span>
            <span class="steptext">
              <span class="steplabel">{step.label}</span>
              <span class="stepparams">{step.params}</span>
            </span>
          </div>
        ))}
        <div class="toolfoot">4 steps · 38s</div>
      </div>

      <p class="text">
        p95 cold start is down from 8.4s to <strong>1.9s</strong>, and the warm pool
        holds through a rolling deploy. Tests pass.
      </p>
    </div>
  </div>
</section>

<style>
  .chat {
    width: 100%;
    max-width: 780px; /* ChatTurnStyles.columnMaxWidth */
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0 24px; /* rowHorizontalPadding */
    box-sizing: border-box;
    text-align: left;
  }

  .turn { display: flex; }
  .turn.user { justify-content: flex-end; }
  .turn.agent { justify-content: flex-start; }

  /* _UserBubble — right-aligned, tertiary-medium fill at 200/255 alpha */
  .bubble {
    max-width: 520px;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    background: var(--chat-user-bubble);
    color: var(--chat-ink);
    font-size: 15px;
    line-height: 1.5;
  }

  /* _AssistantBubble — flush left, no container, 585px prose width */
  .prose {
    max-width: 585px; /* ChatTurnStyles.assistantMaxWidth */
    min-width: 0;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
  }

  .avatar {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--chat-agent-fill);
    border: 1px solid rgba(var(--color-accent-rgb), 0.3);
    color: var(--color-accent);
    font-size: 11px;
    font-weight: 700;
  }

  .who { font-size: 14px; font-weight: 600; color: var(--chat-ink); }
  .meta { font-size: 13px; color: var(--chat-muted); }

  .text {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--chat-ink);
  }

  .text strong { font-weight: 650; }
  .text + .toolcard { margin-top: 0.875rem; }
  .toolcard + .text { margin-top: 0.875rem; }

  /* Grouped tool surface — ParentToolSegment: 12dp radius, ink3 @ 5% */
  .toolcard {
    border-radius: 12px;
    background: var(--chat-tool-fill);
    padding: 12px;
  }

  /* StepperItem: 18px gutter, 8px gap, 12px dot, 1.5px connector */
  .step {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 4px 0;
  }

  .gutter {
    position: relative;
    width: 18px;
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    justify-content: center;
  }

  /* Connector spans the full row so consecutive rows form one unbroken spine;
     the dot sits on top of it. The first/last rows stop at their own dot. */
  .gutter::before {
    content: '';
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: 50%;
    width: 1.5px;
    transform: translateX(-50%);
    background: var(--chat-connector);
  }

  .step.first .gutter::before { top: 14px; }
  .step.last .gutter::before { bottom: calc(100% - 14px); }

  .dot {
    position: relative;
    z-index: 1; /* sits over the connector, mirroring the painter's draw order */
    margin-top: 4px; /* dotTopOffset */
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--chat-dot-fill);
    border: 1.5px solid var(--chat-connector);
    box-sizing: border-box;
  }

  .steptext {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 13px;
    line-height: 20px;
  }

  .steplabel { color: var(--chat-ink); font-weight: 600; }

  .stepparams {
    color: var(--chat-muted);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toolfoot {
    margin-top: 6px;
    padding-left: 26px; /* gutter + gap */
    font-size: 12px;
    color: var(--chat-muted);
  }

  @media (max-width: 720px) {
    .chat { padding: 0 16px; gap: 1rem; }
    .bubble { max-width: 100%; }
  }
</style>
